<div id="index-page" phx-hook="DownloadHandler" class="flex-1 w-full">
  <.navbar_home class="w-full" />

  <section id="home" class="relative min-h-[calc(100vh-72px)] overflow-hidden bg-ink">
    <div class="absolute inset-0">
      <img
        src={~p"/images/payun.jpg"}
        class="h-full w-full object-cover"
        alt="Paisaje natural de Payún"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/78 to-ink/25"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-ink/20"></div>
    </div>

    <div class="relative z-10 mx-auto flex min-h-[calc(100vh-72px)] max-w-7xl items-center px-4 py-20 sm:px-6 lg:px-8">
      <div class="max-w-3xl fade-up">
        <h1 class="text-5xl font-black leading-none tracking-normal text-white sm:text-6xl lg:text-7xl">
          PAYÚN
        </h1>
        <div class="mt-6 inline-flex items-center gap-3 rounded-full border border-white/15 bg-white/10 px-4 py-2 text-sm font-bold uppercase tracking-[0.18em] text-white backdrop-blur">
          <span class="h-2.5 w-2.5 rounded-full bg-brand"></span> Consultora Ambiental
        </div>
        <p class="mt-5 max-w-2xl text-base leading-7 text-sand sm:text-lg">
          Acompañamos a empresas, desarrolladores, industrias y organismos públicos
          con estudios técnicos, cumplimiento normativo y gestión sostenible.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <.landing_button variant="primary" phx-click="download_brochure">
            <.icon name="hero-arrow-down-tray-mini" class="h-5 w-5" /> Descargar brochure
          </.landing_button>
          <a
            href="#contacto"
            class="inline-flex items-center justify-center gap-2 rounded-full border border-white/40 bg-white/10 px-7 py-3.5 text-base font-bold text-white shadow-lg shadow-black/10 backdrop-blur transition hover:bg-white/20"
          >
            <.icon name="hero-chat-bubble-left-right-mini" class="h-5 w-5" /> Contactar
          </a>
        </div>

        <%!-- <div class="mt-10 grid max-w-3xl grid-cols-1 gap-3 sm:grid-cols-3">
          <div class="rounded-lg border border-white/15 bg-white/10 p-4 backdrop-blur">
            <p class="text-3xl font-black text-white">15+</p>
            <p class="mt-1 text-sm text-sand">Años de experiencia</p>
          </div>
          <div class="rounded-lg border border-white/15 bg-white/10 p-4 backdrop-blur">
            <p class="text-3xl font-black text-white">100+</p>
            <p class="mt-1 text-sm text-sand">Proyectos realizados</p>
          </div>
          <div class="rounded-lg border border-white/15 bg-white/10 p-4 backdrop-blur">
            <p class="text-3xl font-black text-white">3</p>
            <p class="mt-1 text-sm text-sand">Provincias de actuación</p>
          </div>
        </div> --%>
      </div>
    </div>
  </section>

  <section id="nosotros" class="bg-sand-light py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div class="flex flex-col overflow-hidden rounded-lg bg-ink shadow-xl shadow-ink/10 lg:self-stretch">
          <div class="relative aspect-square lg:aspect-auto lg:min-h-[480px] lg:flex-1">
            <img
              src={~p"/images/payunias2.jpeg"}
              class="absolute inset-0 h-full w-full object-cover object-center"
              alt="Integrantes del equipo Payún con cascos y chalecos durante una visita de campo"
            />
          </div>
        </div>

        <div>
          <p class="text-sm font-bold uppercase tracking-[0.18em] text-brand">Sobre nosotras</p>
          <h2 class="mt-3 text-3xl font-black tracking-normal text-ink sm:text-4xl">
            Gestión socioambiental clara para la toma de decisiones
          </h2>
          <p class="mt-5 text-lg leading-8 text-earth/70">
            PAYÚN surge de la experiencia compartida en proyectos de infraestructura
            y gestión pública. Brindamos asesoramiento técnico, ágil y estratégico
            en todas las etapas del proyecto.
          </p>

          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            <div class="rounded-lg border border-sand bg-paper p-5 shadow-sm">
              <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-soft text-brand">
                <.icon name="hero-flag" class="h-5 w-5" />
              </div>
              <h3 class="font-extrabold text-ink">Misión</h3>
              <p class="mt-2 text-sm leading-6 text-earth/70">
                Acompañar la gestión ambiental y social de empresas y organizaciones con
                soluciones adaptadas al territorio que aseguren el cumplimiento normativo
                y promuevan el desarrollo sostenible.
              </p>
            </div>
            <div class="rounded-lg border border-sand bg-paper p-5 shadow-sm">
              <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-sun-soft text-sun-ink">
                <.icon name="hero-eye" class="h-5 w-5" />
              </div>
              <h3 class="font-extrabold text-ink">Visión</h3>
              <p class="mt-2 text-sm leading-6 text-earth/70">
                Ser referentes en la gestión ambiental y social, integrando estándares locales
                e internacionales, con especial énfasis en proyectos financiados por
                organismos multilaterales de fomento.
              </p>
            </div>
          </div>

          <div class="mt-8">
            <a
              href="/equipo"
              class="inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-bold text-white transition hover:bg-earth"
            >
              Conocé a nuestro equipo <.icon name="hero-arrow-right-mini" class="h-4 w-4" />
            </a>
          </div>
        </div>
      </div>

      <h2 class="mt-16 text-sm font-bold uppercase tracking-[0.18em] text-brand">
        Cómo trabajamos
      </h2>
      <div class="mt-6 grid gap-4 md:grid-cols-4">
        <div class="rounded-lg border border-sand bg-paper p-5">
          <span class="text-sm font-black text-brand">01</span>
          <h3 class="mt-3 font-extrabold text-ink">Diagnóstico</h3>
          <p class="mt-2 text-sm leading-6 text-earth/70">
            Interpretamos el contexto socioambiental y normativo.
          </p>
        </div>
        <div class="rounded-lg border border-sand bg-paper p-5">
          <span class="text-sm font-black text-brand">02</span>
          <h3 class="mt-3 font-extrabold text-ink">Planificación</h3>
          <p class="mt-2 text-sm leading-6 text-earth/70">
            Definimos estudios, permisos y prioridades de gestión.
          </p>
        </div>
        <div class="rounded-lg border border-sand bg-paper p-5">
          <span class="text-sm font-black text-brand">03</span>
          <h3 class="mt-3 font-extrabold text-ink">Implementación</h3>
          <p class="mt-2 text-sm leading-6 text-earth/70">
            Gestionamos presentaciones y visitas de obra, y acompañamos auditorías e inspecciones.
          </p>
        </div>
        <div class="rounded-lg border border-sand bg-paper p-5">
          <span class="text-sm font-black text-brand">04</span>
          <h3 class="mt-3 font-extrabold text-ink">Seguimiento</h3>
          <p class="mt-2 text-sm leading-6 text-earth/70">
            Medimos avances, actualizamos y sostenemos la mejora continua.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="servicios" class="bg-paper py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-brand">Servicios</p>
        <h2 class="mt-3 text-3xl font-black tracking-normal text-ink sm:text-4xl">
          Acompañamiento para todas las etapas del proyecto
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2">
        <.service_card
          icon="hero-document-magnifying-glass"
          tone="brand"
          title="Evaluación y Planificación Ambiental"
          description="Estudios de impacto ambiental, tránsito, ruidos y viabilidad socioambiental."
          href="/servicios#evaluacion-planificacion"
        />
        <.service_card
          icon="hero-shield-check"
          tone="earth"
          title="Gestión y Cumplimiento en Obras y Operaciones"
          description="Responsabilidad ambiental, planes de gestión, residuos y permisos ambientales."
          href="/servicios#gestion-cumplimiento"
        />
        <.service_card
          icon="hero-arrow-trending-up"
          tone="sun"
          title="Sostenibilidad, Cambio Climático y Sistemas de Gestión"
          description="GEI, economía circular, estrategias de sostenibilidad e implementación de ISO 14001."
          href="/servicios#sostenibilidad"
        />
        <.service_card
          icon="hero-users"
          tone="slate"
          title="Gestión Social y Formación"
          description="Capacitaciones, talleres con comunidades y sondeos de opinión."
          href="/servicios#gestion-social"
        />
      </div>
    </div>
  </section>

  <section id="sectores" class="bg-sand-light py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.18em] text-brand">Sectores</p>
          <h2 class="mt-3 text-3xl font-black tracking-normal text-ink sm:text-4xl">
            Trayectoria y experiencia
          </h2>
          <p class="mt-4 text-lg leading-8 text-earth/70">
            Participamos en proyectos de distintos sectores, escalas y marcos de financiamiento.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <%= for sector <- [
            %{icon: "hero-bolt", title: "Energía e infraestructura eléctrica", text: "Parques solares fotovoltaicos, infraestructura eléctrica y líneas de vinculación."},
            %{icon: "hero-building-office-2", title: "Obras e infraestructura urbana", text: "Obras viales, hidráulicas y de desarrollo urbano."},
            %{icon: "hero-document-magnifying-glass", title: "Evaluación ambiental", text: "Proyectos sujetos a evaluación ambiental provincial y municipal."},
            %{icon: "hero-globe-alt", title: "Financiamiento internacional", text: "Obras con financiamiento y estándares socioambientales internacionales."}
          ] do %>
            <div class="rounded-lg border border-sand bg-paper p-6 shadow-sm">
              <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-brand-soft text-brand">
                <.icon name={sector.icon} class="h-6 w-6" />
              </div>
              <h3 class="font-extrabold text-ink">{sector.title}</h3>
              <p class="mt-2 text-sm leading-6 text-earth/70">{sector.text}</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <section id="contacto" class="bg-paper py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.18em] text-brand">Contacto</p>
          <h2 class="mt-3 text-3xl font-black tracking-normal text-ink sm:text-4xl">
            Hablemos de tu proyecto
          </h2>
          <p class="mt-4 text-lg leading-8 text-earth/70">
            Contanos qué necesitás evaluar, presentar o resolver. Te respondemos
            con el próximo paso técnico más conveniente.
          </p>

          <div class="mt-8 space-y-4">
            <a
              href="mailto:payunconsultora@gmail.com"
              class="flex items-center gap-4 rounded-lg border border-sand bg-sand-light p-4 transition hover:border-brand/40 hover:bg-brand-soft"
            >
              <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-paper text-brand shadow-sm">
                <.icon name="hero-envelope" class="h-6 w-6" />
              </span>
              <span>
                <span class="block text-sm font-bold text-ink">Email</span>
                <span class="block text-sm text-earth/70">payunconsultora@gmail.com</span>
              </span>
            </a>
            <a
              href="https://wa.me/5492615135614"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 rounded-lg border border-sand bg-sand-light p-4 transition hover:border-sun-ink/40 hover:bg-sun-soft"
            >
              <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-paper text-sun-ink shadow-sm">
                <.icon name="hero-chat-bubble-left-right" class="h-6 w-6" />
              </span>
              <span>
                <span class="block text-sm font-bold text-ink">WhatsApp</span>
                <span class="block text-sm text-earth/70">Consulta directa</span>
              </span>
            </a>
          </div>
        </div>

        <.contact_form />
      </div>
    </div>
  </section>

  <.footer class="w-full" />
</div>
