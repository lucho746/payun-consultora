<.header>
  Index {@index.id}
  <:subtitle>This is a index record from your database.</:subtitle>
  <:actions>
    <.link patch={~p"/index/#{@index}/show/edit"} phx-click={JS.push_focus()}>
      <.button>Edit index</.button>
    </.link>
  </:actions>
</.header>

<.list></.list>

<.back navigate={~p"/index"}>Back to index</.back>

<.modal
  :if={@live_action == :edit}
  id="index-modal"
  show
  on_cancel={JS.patch(~p"/index/#{@index}")}
>
  <.live_component
    module={ConsultoraWeb.IndexLive.FormComponent}
    id={@index.id}
    title={@page_title}
    action={@live_action}
    index={@index}
    patch={~p"/index/#{@index}"}
  />
</.modal>
